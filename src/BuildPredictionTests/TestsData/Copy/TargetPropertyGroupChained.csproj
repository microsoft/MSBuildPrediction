<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" DefaultTargets="CopyWithChainedProps" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{0000000A-0000-00AA-AA00-0AA00A00A00A}</ProjectGuid>
    <OutputType>Exe</OutputType>
    <OutDir>objd\amd64</OutDir>
    <RootNamespace>SomeNamespace</RootNamespace>
    <AssemblyName>SomeName</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <FilesToCopy Include="copy1.dll" />
    <FilesToCopy Include="copy2.dll" />
  </ItemGroup>
  <!-- Two properties in the target where the second depends on the first -->
  <Target Name="CopyWithChainedProps">
    <PropertyGroup>
      <BaseTargetDir>target\$(Configuration)\$(Platform)</BaseTargetDir>
      <FullTargetDir>$(BaseTargetDir)\chained</FullTargetDir>
    </PropertyGroup>
    <Copy SourceFiles="@(FilesToCopy)" DestinationFolder="$(FullTargetDir)" />
  </Target>
</Project>
