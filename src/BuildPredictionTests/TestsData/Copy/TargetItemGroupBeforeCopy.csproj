<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" DefaultTargets="CopyWithTargetItems" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{0000000A-0000-00AA-AA00-0AA00A00A00A}</ProjectGuid>
    <OutputType>Exe</OutputType>
    <OutDir>objd\amd64</OutDir>
    <RootNamespace>SomeNamespace</RootNamespace>
    <AssemblyName>SomeName</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <FilesToCopy Include="copy1.dll" />
    <FilesToCopy Include="copy2.dll" />
  </ItemGroup>
  <!-- Items and property defined inside the target -->
  <Target Name="CopyWithTargetItems">
    <PropertyGroup>
      <CopyDestDir>target\$(Configuration)\$(Platform)\itemgroup</CopyDestDir>
    </PropertyGroup>
    <ItemGroup>
      <DestFiles Include="$(CopyDestDir)\copy1.dll" />
      <DestFiles Include="$(CopyDestDir)\copy2.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(FilesToCopy)" DestinationFiles="@(DestFiles)" />
  </Target>
</Project>
