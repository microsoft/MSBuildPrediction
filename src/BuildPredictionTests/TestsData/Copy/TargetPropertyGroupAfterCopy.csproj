<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" DefaultTargets="CopyBeforeProps" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{0000000A-0000-00AA-AA00-0AA00A00A00A}</ProjectGuid>
    <OutputType>Exe</OutputType>
    <OutDir>objd\amd64</OutDir>
    <RootNamespace>SomeNamespace</RootNamespace>
    <AssemblyName>SomeName</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <FilesToCopy Include="copy1.dll" />
  </ItemGroup>
  <!-- Copy task uses a property that is defined AFTER it in the target.
       The property should NOT be available, so destination resolves to just the empty expansion. -->
  <Target Name="CopyBeforeProps">
    <Copy SourceFiles="@(FilesToCopy)" DestinationFolder="$(LateDefinedDestination)" />
    <PropertyGroup>
      <LateDefinedDestination>target\late</LateDefinedDestination>
    </PropertyGroup>
  </Target>
</Project>
