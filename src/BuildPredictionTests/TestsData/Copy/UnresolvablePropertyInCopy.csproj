<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" DefaultTargets="CopyWithUnresolved" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{0000000A-0000-00AA-AA00-0AA00A00A00A}</ProjectGuid>
    <OutputType>Exe</OutputType>
    <OutDir>objd\amd64</OutDir>
    <RootNamespace>SomeNamespace</RootNamespace>
    <AssemblyName>SomeName</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <FilesToCopy Include="copy1.dll" />
  </ItemGroup>
  <!-- DestinationFolder uses a property that is never defined anywhere.
       The predictor should not predict output for this Copy task. -->
  <Target Name="CopyWithUnresolved">
    <Copy SourceFiles="@(FilesToCopy)" DestinationFolder="$(NeverDefinedProperty)\subfolder" />
  </Target>
</Project>
